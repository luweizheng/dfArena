{
  "files": {
    "output_01.csv": {
      "key": [
        "Name",
        "Payment Date"
      ],
      "columns": {
        "Name": {
          "type": "text_exact",
          "null_values": []
        },
        "Payment Date": {
          "type": "date",
          "formats": [
            "%d/%m/%Y"
          ]
        },
        "Monthly Cost": {
          "type": "number",
          "abs_tol": 0,
          "rel_tol": 0
        },
        "Cumulative Monthly Cost": {
          "type": "number",
          "abs_tol": 0,
          "rel_tol": 0
        }
      },
      "ignore_order": true
    }
  }
}
