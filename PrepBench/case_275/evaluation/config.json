{
  "files": {
    "output_01.csv": {
      "key": [
        "Receipt Number"
      ],
      "columns": {
        "Rank": {
          "type": "integer",
          "null_values": []
        },
        "Customer ID": {
          "type": "text_exact",
          "null_values": [
            "",
            "nan",
            "NaN",
            "null",
            "None"
          ]
        },
        "Receipt Number": {
          "type": "text_exact",
          "null_values": []
        },
        "Gender": {
          "type": "text_exact",
          "null_values": []
        },
        "Online or In Person": {
          "type": "text_exact",
          "null_values": []
        },
        "Sales": {
          "type": "number",
          "abs_tol": 0,
          "rel_tol": 0,
          "null_values": []
        },
        "Weekday": {
          "type": "text_exact",
          "null_values": []
        }
      },
      "ignore_order": false,
      "order_by": [
        {
          "column": "Sales",
          "direction": "desc",
          "nulls": "last"
        },
        {
          "column": "Receipt Number",
          "direction": "asc",
          "nulls": "last"
        }
      ]
    }
  }
}
