{
  "files": {
    "output_01.csv": {
      "key": [
        "Account Number",
        "Balance Date",
        "Transaction Value"
      ],
      "columns": {
        "Account Number": {
          "type": "integer"
        },
        "Balance Date": {
          "type": "date",
          "formats": [
            "%d/%m/%Y"
          ]
        },
        "Transaction Value": {
          "type": "number",
          "abs_tol": 0,
          "rel_tol": 0
        },
        "Balance": {
          "type": "number",
          "abs_tol": 0,
          "rel_tol": 0
        }
      },
      "ignore_order": true
    }
  }
}
