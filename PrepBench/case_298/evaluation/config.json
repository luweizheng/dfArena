{
  "files": {
    "output_01.csv": {
      "key": [
        "Product ID"
      ],
      "ignore_order": true,
      "columns": {
        "Category": {
          "type": "text_norm",
          "null_values": []
        },
        "Product": {
          "type": "text_exact",
          "null_values": []
        },
        "Product ID": {
          "type": "text_exact",
          "null_values": []
        },
        "Price": {
          "type": "number",
          "null_values": [],
          "abs_tol": 0,
          "rel_tol": 0
        },
        "Sales": {
          "type": "number",
          "null_values": [],
          "abs_tol": 1e-12,
          "rel_tol": 0
        },
        "% of Total": {
          "type": "number",
          "null_values": [],
          "abs_tol": 0.005,
          "rel_tol": 0
        }
      }
    }
  }
}
